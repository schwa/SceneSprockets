@Tutorial(time: 5) {
    @Intro(title: "Draw a sphere") {
        A scene graph is a tree of nodes. A node with a shape and a material draws a mesh. A `SceneView` draws the graph in SwiftUI.

        @Image(source: "tutorial-01-sphere.png", alt: "A blue sphere on a black background.")
    }

    @Section(title: "Make a scene graph and show it") {
        @ContentAndMedia {
            Make a scene graph with one sphere, then show it in a `SceneView`.

            @Image(source: "tutorial-01-sphere.png", alt: "A blue sphere on a black background.")
        }

        @Steps {
            @Step {
                Make a view that keeps a `SceneGraph` in state. Every scene graph has one root node.

                @Code(name: "Tutorial1Sphere.swift", file: "tutorial-01-01.swift")
            }

            @Step {
                Add a child node with a sphere shape and a Blinn-Phong material.

                @Code(name: "Tutorial1Sphere.swift", file: "tutorial-01-02.swift")
            }

            @Step {
                Show the graph in a `SceneView`. The scene has no camera, so `SceneView` uses a default camera that frames the scene. The scene has no lights, so `.sceneDefaultLighting()` adds a light at the camera. `.sceneCameraControl()` lets you drag to orbit the camera.

                @Code(name: "Tutorial1Sphere.swift", file: "tutorial-01-03.swift")
            }
        }
    }
}
