# A 4 x 0.5 x 4 slab, top face at y = 0. Top and sides use different materials.
mtllib Pedestal.mtl
o Pedestal
v -2 0 -2
v 2 0 -2
v 2 0 2
v -2 0 2
v -2 -0.5 -2
v 2 -0.5 -2
v 2 -0.5 2
v -2 -0.5 2
vn 0 1 0
vn 0 0 1
vn 0 0 -1
vn 1 0 0
vn -1 0 0
vn 0 -1 0
usemtl Top
f 1//1 4//1 3//1
f 1//1 3//1 2//1
usemtl Side
f 4//2 8//2 7//2
f 4//2 7//2 3//2
f 2//3 6//3 5//3
f 2//3 5//3 1//3
f 3//4 7//4 6//4
f 3//4 6//4 2//4
f 1//5 5//5 8//5
f 1//5 8//5 4//5
f 5//6 6//6 7//6
f 5//6 7//6 8//6
